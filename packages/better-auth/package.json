{
  "name": "@package/better-auth",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "::generate-secret": "bunx @better-auth/cli@latest secret",
    "::generate-schemas": "bunx @better-auth/cli@latest generate --y",
    "::migrate-schemas": "bunx @better-auth/cli@latest migrate --y",
    "::db-generate-schemas":"bunx kysely-codegen --out-file ./database/better-auth-db.d.ts --url file:./database/better-auth.sqlite --dialect libsql",
    "postinstall": "bun run ::generate-schemas && bun run ::migrate-schemas && bun run ::db-generate-schemas",
    "build": "tsc --project tsconfig.build.json"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "@libsql/client": "^0.15.2",
    "@libsql/kysely-libsql": "^0.4.1",
    "@package/email": "workspace:*",
    "@types/nodemailer": "^6.4.17",
    "better-auth": "^1.2.5",
    "kysely-codegen": "^0.18.3",
    "nodemailer": "^6.9.16"
  }
}