// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

generator faker {
  provider = "prisma-generator-fake-data"
  output   = "./generated/faker/index.ts"
}

generator prismabox { 
  provider = "prismabox"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName = "t"
  inputModel = true
  additionalProperties = true
  output   = "./generated/prismabox"
} 

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  ///FAKE:faker.person.fullName()
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ///FAKE:faker.datatype.boolean({ probability: 0.5 })
  emailVerified Boolean  @default(false)
  ///FAKE:faker.image.avatar()
  image         String?

  sessions    Session[]
  accounts    Account[]
  teammembers TeamMember[]
  members     Member[]
  invitations Invitation[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  ///FAKE:faker.internet.jwt()
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ///FAKE:faker.internet.ipv4()
  ipAddress            String?
  ///FAKE:faker.internet.userAgent()
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  activeTeamId         String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  ///FAKE:faker.string.uuid()
  accountId             String
  ///FAKE:faker.string.uuid()
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model OrganizationRole {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  permission     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt

  @@map("organizationRole")
}

model Team {
  id             String       @id
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime
  updatedAt      DateTime?    @updatedAt
  teammembers    TeamMember[]

  @@map("team")
}

model TeamMember {
  id        String    @id
  teamId    String
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime?

  @@map("teamMember")
}

model Organization {
  id                String             @id
  name              String
  slug              String?
  logo              String?
  createdAt         DateTime
  metadata          String?
  organizationroles OrganizationRole[]
  teams             Team[]
  members           Member[]
  invitations       Invitation[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  teamId         String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}
