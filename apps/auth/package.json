{
  "name": "@app/auth",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/init.ts",
    "::seed": "bunx --bun @better-auth-kit/cli@latest seed --config ./utils/auth.ts",
    "::generate-db": "bun run ::generate-schemas-auth && bun run ::generate-types-env && bun run ::generate-types-database",
    "::migrate": "bunx @better-auth/cli@latest migrate --y",
    "::generate": "bunx @better-auth/cli@latest generate --y",
    "::generate-types-env": "bunx gen-env-types ./.env -o ./types/.d.ts",
    "::generate-types-database": "bunx kysely-codegen --out-file ./database/better-auth-db.d.ts --url file:./database/better-auth.sqlite --dialect libsql"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/openapi": "^1.4.9",
    "@libsql/client": "^0.15.15",
    "@libsql/kysely-libsql": "^0.4.1",
    "@prisma/client": "^6.16.2",
    "better-auth": "^1.3.13",
    "elysia": "^1.4.6",
    "logestic": "^1.2.4",
    "prisma": "^6.16.2",
    "prismabox": "^1.1.25",
    "typebox": "^1.0.19"
  },
  "devDependencies": {
    "@better-auth-kit/seed": "^1.0.12",
    "@faker-js/faker": "^10.0.0",
    "@types/bun": "^1.2.23",
    "@types/node": "^24.5.2",
    "bun-types": "latest",
    "prisma-generator-fake-data": "^0.16.2"
  },
  "prisma": {
    "seed": "bun run prisma/seed/index.ts"
  },
  "module": "src/index.js"
}
