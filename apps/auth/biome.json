{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",

  "formatter": { "enabled": true, "indentStyle": "space" },
  "files": {
    "ignoreUnknown": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "useTemplate": "off"
      },
      "performance": {
        "noDelete": "off"
      },
      "recommended": true
    }
  },
  "javascript": { "formatter": { "quoteStyle": "single" } }
}
