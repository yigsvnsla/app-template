{
  "extends": "@packages/config/typescript/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@packages/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@app/auth/*": [
        "../../apps/auth/*"
      ]
    },

  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}